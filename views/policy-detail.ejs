<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-sm">
      <div class="card-body">
        <h3 class="card-title">
          <% if (policy.type === 'vehicle_2w') { %>
            <i class="bi bi-bicycle text-primary"></i> 2-Wheeler Insurance
          <% } else if (policy.type === 'vehicle_4w') { %>
            <i class="bi bi-car-front text-success"></i> 4-Wheeler Insurance
          <% } else { %>
            <i class="bi bi-heart-pulse text-danger"></i> Health Insurance
          <% } %>
        </h3>
        <hr>
        <div class="row">
          <div class="col-md-6">
            <p><strong>Provider:</strong> <%= policy.provider %></p>
            <p><strong>Premium:</strong> ₹<%= policy.premium %>/year</p>
            <p><strong>Coverage:</strong> ₹<%= policy.coverage_amount ? policy.coverage_amount.toLocaleString() : 'N/A' %></p>
          </div>
          <div class="col-md-6">
            <p><strong>Type:</strong> <%= policy.type %></p>
            <p><strong>Status:</strong> <span class="badge bg-info"><%= policy.status %></span></p>
          </div>
        </div>
        <hr>
        <h5>Generate a Quote</h5>
        <form method="POST" action="/policies/<%= policy.policy_id %>/quote">
          <div class="mb-3">
            <label for="age" class="form-label">Your Age</label>
            <input type="number" class="form-control" id="age" name="age" min="18" max="80" value="30" required>
          </div>
          <button type="submit" class="btn btn-success"><i class="bi bi-calculator"></i> Get Quote</button>
        </form>
      </div>
    </div>
    <a href="/policies" class="btn btn-outline-secondary mt-3"><i class="bi bi-arrow-left"></i> Back to Search</a>
  </div>
</div>

<%- include('partials/footer') %>
