<%- include('partials/header') %>

<h2 class="mb-4">
  <i class="bi bi-speedometer2"></i> Dashboard
  <span class="badge bg-secondary fs-6"><%= user.role %></span>
</h2>

<div class="row g-4">
  <% if (user.role === 'customer' || user.role === 'agent') { %>
    <div class="col-md-4">
      <div class="card border-primary h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-search display-4 text-primary"></i>
          <h5 class="card-title mt-3">Search Policies</h5>
          <p class="card-text text-muted">Browse and compare insurance policies</p>
          <a href="/policies" class="btn btn-primary">Search Now</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-success h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-file-earmark-text display-4 text-success"></i>
          <h5 class="card-title mt-3">My Policies</h5>
          <p class="card-text text-muted">View your purchased policies</p>
          <a href="/my-policies" class="btn btn-success">View Policies</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-warning h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-clipboard-data display-4 text-warning"></i>
          <h5 class="card-title mt-3">Claims</h5>
          <p class="card-text text-muted">Submit or track insurance claims</p>
          <a href="/claims" class="btn btn-warning">My Claims</a>
        </div>
      </div>
    </div>
  <% } %>

  <% if (user.role === 'admin') { %>
    <div class="col-md-4">
      <div class="card border-info h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-gear display-4 text-info"></i>
          <h5 class="card-title mt-3">Manage Policies</h5>
          <p class="card-text text-muted">Create and manage policy templates</p>
          <a href="/admin/policies" class="btn btn-info">Manage</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-danger h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-clipboard-check display-4 text-danger"></i>
          <h5 class="card-title mt-3">Review Claims</h5>
          <p class="card-text text-muted">Review and process insurance claims</p>
          <a href="/adjuster/claims" class="btn btn-danger">Review</a>
        </div>
      </div>
    </div>
  <% } %>

  <% if (user.role === 'claims_adjuster') { %>
    <div class="col-md-4">
      <div class="card border-danger h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-clipboard-check display-4 text-danger"></i>
          <h5 class="card-title mt-3">Review Claims</h5>
          <p class="card-text text-muted">Evaluate and approve/reject claims</p>
          <a href="/adjuster/claims" class="btn btn-danger">Review Claims</a>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
