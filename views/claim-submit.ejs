<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-warning">
        <h4 class="mb-0"><i class="bi bi-clipboard-plus"></i> Submit a Claim</h4>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (policies.length === 0) { %>
          <div class="alert alert-info">
            You don't have any active policies. <a href="/policies">Purchase a policy first</a>.
          </div>
        <% } else { %>
          <form method="POST" action="/claims">
            <div class="mb-3">
              <label for="policyId" class="form-label">Select Policy</label>
              <select class="form-select" id="policyId" name="policyId" required>
                <option value="">-- Choose a policy --</option>
                <% policies.forEach(p => { %>
                  <option value="<%= p.policy_id %>">
                    #<%= p.policy_id %> — <%= p.type %> (₹<%= p.premium %>)
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label for="amount" class="form-label">Claim Amount (₹)</label>
              <input type="number" class="form-control" id="amount" name="amount" min="1" required>
            </div>
            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="3" placeholder="Describe the reason for your claim..." required></textarea>
            </div>
            <button type="submit" class="btn btn-warning w-100"><i class="bi bi-send"></i> Submit Claim</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
