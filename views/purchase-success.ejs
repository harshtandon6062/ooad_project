<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6 text-center">
    <div class="card shadow border-success">
      <div class="card-body py-5">
        <i class="bi bi-check-circle-fill text-success display-1"></i>
        <h2 class="mt-3 text-success">Purchase Successful!</h2>
        <p class="text-muted">Your policy has been issued successfully.</p>
        <hr>
        <div class="text-start mx-auto" style="max-width: 300px;">
          <p><strong>Policy ID:</strong> #<%= policyId %></p>
          <p><strong>Policy Type:</strong> <%= policyType %></p>
          <p><strong>Amount Paid:</strong> ₹<%= amount %></p>
          <p><strong>Payment ID:</strong> #<%= paymentId %></p>
        </div>
        <hr>
        <a href="/my-policies" class="btn btn-primary me-2"><i class="bi bi-file-earmark-text"></i> View My Policies</a>
        <a href="/dashboard" class="btn btn-outline-secondary"><i class="bi bi-house"></i> Dashboard</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
