<%- include('partials/header') %>

<h2 class="mb-4"><i class="bi bi-search"></i> Search Insurance Policies</h2>

<!-- Filters -->
<div class="card mb-4 shadow-sm">
  <div class="card-body">
    <form method="GET" action="/policies" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label for="type" class="form-label">Policy Type</label>
        <select class="form-select" id="type" name="type">
          <option value="">All Types</option>
          <option value="vehicle_2w" <%= filters.type === 'vehicle_2w' ? 'selected' : '' %>>2-Wheeler Vehicle</option>
          <option value="vehicle_4w" <%= filters.type === 'vehicle_4w' ? 'selected' : '' %>>4-Wheeler Vehicle</option>
          <option value="health" <%= filters.type === 'health' ? 'selected' : '' %>>Health Insurance</option>
        </select>
      </div>
      <div class="col-md-4">
        <label for="maxPremium" class="form-label">Max Premium (₹)</label>
        <input type="number" class="form-control" id="maxPremium" name="maxPremium" value="<%= filters.maxPremium %>" placeholder="e.g. 5000">
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-filter"></i> Filter</button>
        <a href="/policies" class="btn btn-outline-secondary">Clear</a>
      </div>
    </form>
  </div>
</div>

<!-- Results -->
<% if (policies.length === 0) { %>
  <div class="alert alert-info">No policies found. Try adjusting your filters.</div>
<% } else { %>
  <div class="row g-4">
    <% policies.forEach(policy => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0">
                <% if (policy.type === 'vehicle_2w') { %>
                  <i class="bi bi-bicycle text-primary"></i> 2-Wheeler
                <% } else if (policy.type === 'vehicle_4w') { %>
                  <i class="bi bi-car-front text-success"></i> 4-Wheeler
                <% } else { %>
                  <i class="bi bi-heart-pulse text-danger"></i> Health
                <% } %>
              </h5>
              <span class="badge bg-primary">₹<%= policy.premium %>/yr</span>
            </div>
            <p class="text-muted mb-1"><strong>Provider:</strong> <%= policy.provider %></p>
            <p class="text-muted mb-3"><strong>Coverage:</strong> ₹<%= policy.coverage_amount ? policy.coverage_amount.toLocaleString() : 'N/A' %></p>
            <a href="/policies/<%= policy.policy_id %>" class="btn btn-outline-primary btn-sm w-100">View Details & Get Quote</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
