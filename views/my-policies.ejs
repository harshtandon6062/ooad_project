<%- include('partials/header') %>

<h2 class="mb-4"><i class="bi bi-file-earmark-text"></i> My Policies</h2>

<% if (policies.length === 0) { %>
  <div class="alert alert-info">
    You don't have any policies yet. <a href="/policies">Search and purchase a policy</a>.
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-hover shadow-sm">
      <thead class="table-primary">
        <tr>
          <th>ID</th>
          <th>Type</th>
          <th>Provider</th>
          <th>Premium</th>
          <th>Start Date</th>
          <th>Expiry Date</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% policies.forEach(p => { %>
          <tr>
            <td>#<%= p.policy_id %></td>
            <td>
              <% if (p.type === 'vehicle_2w') { %>
                <i class="bi bi-bicycle"></i> 2-Wheeler
              <% } else if (p.type === 'vehicle_4w') { %>
                <i class="bi bi-car-front"></i> 4-Wheeler
              <% } else { %>
                <i class="bi bi-heart-pulse"></i> Health
              <% } %>
            </td>
            <td><%= p.provider %></td>
            <td>₹<%= p.premium %></td>
            <td><%= p.start_date %></td>
            <td><%= p.expiry_date %></td>
            <td>
              <span class="badge bg-<%= p.status === 'active' ? 'success' : 'secondary' %>"><%= p.status %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
