<%- include('partials/header') %>

<h2 class="mb-4"><i class="bi bi-clipboard-check"></i> Review Claims</h2>

<% if (claims.length === 0) { %>
  <div class="alert alert-info">No claims to review.</div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-hover shadow-sm">
      <thead class="table-danger">
        <tr>
          <th>Claim ID</th>
          <th>Customer</th>
          <th>Policy Type</th>
          <th>Amount</th>
          <th>Description</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% claims.forEach(c => { %>
          <tr>
            <td>#<%= c.claim_id %></td>
            <td><%= c.user_name %></td>
            <td><%= c.policy_type %></td>
            <td>₹<%= c.amount %></td>
            <td><%= c.description ? c.description.substring(0, 40) : '' %></td>
            <td>
              <% if (c.status === 'submitted') { %>
                <span class="badge bg-warning text-dark">Submitted</span>
              <% } else if (c.status === 'under_review') { %>
                <span class="badge bg-info">Under Review</span>
              <% } else if (c.status === 'approved') { %>
                <span class="badge bg-success">Approved</span>
              <% } else { %>
                <span class="badge bg-danger">Rejected</span>
              <% } %>
            </td>
            <td>
              <% if (c.status === 'submitted' || c.status === 'under_review') { %>
                <form method="POST" action="/adjuster/claims/<%= c.claim_id %>" class="d-inline">
                  <input type="hidden" name="status" value="under_review">
                  <button type="submit" class="btn btn-sm btn-info" <% if (c.status === 'under_review') { %>disabled<% } %>>Review</button>
                </form>
                <form method="POST" action="/adjuster/claims/<%= c.claim_id %>" class="d-inline">
                  <input type="hidden" name="status" value="approved">
                  <button type="submit" class="btn btn-sm btn-success">Approve</button>
                </form>
                <form method="POST" action="/adjuster/claims/<%= c.claim_id %>" class="d-inline">
                  <input type="hidden" name="status" value="rejected">
                  <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                </form>
              <% } else { %>
                <span class="text-muted">Resolved</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
